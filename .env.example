# flash-rag configuration
#
# Copy this file to `.env` and edit:   cp .env.example .env
# `.env` is git-ignored — put anything personal in it.
# Real environment variables (exported in the shell) always take
# precedence over values in this file.

# --- Embedding model -------------------------------------------------------
# fastembed model id. Options (see README "Research notes"):
#   nomic-ai/nomic-embed-text-v1.5        (default — 137M, 768-dim, best balance)
#   nomic-ai/nomic-embed-text-v1.5-Q      (quantized — ~1.7x faster, same quality)
#   BAAI/bge-small-en-v1.5                (33M, 384-dim — fastest, big corpora)
#   Qwen/Qwen3-Embedding-0.6B             (top MTEB, 32k context — heavier)
# WARNING: changing the model changes the vector space -> `uv run db-init --force`
FLASH_RAG_MODEL=nomic-ai/nomic-embed-text-v1.5

# --- Paths (relative paths resolve against the project root) ---------------
#FLASH_RAG_DOCS_DIR=documents
#FLASH_RAG_DATA_DIR=.data

# --- Extra workspace directories to index (comma-separated) ----------------
# Index additional folders (recursively, subfolders included) beyond
# documents/. Junk dirs (node_modules, __pycache__, dist, build, .git, ...)
# and hidden files are ignored automatically. Relative paths resolve against
# the project root; absolute paths work too.
#FLASH_RAG_WORKSPACE_DIRS=path/demo,path2/demo2,path3/demo3

# --- ONNX Runtime providers (GPU on Apple Silicon) --------------------------
# On M1/M2/M3/M4 Macs, route inference through CoreML (GPU/ANE) with a CPU
# fallback. On Linux/Windows leave unset (CPU) or use a CUDA build.
#FLASH_RAG_PROVIDERS=CoreMLExecutionProvider,CPUExecutionProvider
